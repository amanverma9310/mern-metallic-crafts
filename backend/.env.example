# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# MongoDB connection string. For local MongoDB:
#   MONGO_URI=mongodb://127.0.0.1:27017/metallic-crafts
# For MongoDB Atlas, use the connection string from your cluster, e.g.:
#   MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/metallic-crafts
MONGO_URI=mongodb+srv://Amanvermav89900:amanverma1234@cluster0.rvmvyac.mongodb.net/?appName=Cluster0

# Secret used to sign JWTs. Use a long, random string in production.
JWT_SECRET=x7K9pQ2vN4mR8tL1wZ6cF3hB5sJ0yA


# How long issued JWTs stay valid.
JWT_EXPIRES_IN=7d

# Port the Express server listens on.
PORT=5000

# Comma-separated list of allowed frontend origins for CORS.
# The Vite dev server default is http://localhost:5173
CORS_ORIGIN=http://localhost:5173
